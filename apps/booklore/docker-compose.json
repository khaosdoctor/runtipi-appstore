{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/dynamic-compose.json",
  "services": [
    {
      "name": "booklore",
      "image": "booklore/booklore:v1.15.0",
      "internalPort": 6060,
      "isMain": true,
      "environment": [
        {
          "key": "USER_ID",
          "value": "1000"
        },
        {
          "key": "GROUP_ID",
          "value": "1000"
        },
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "DATABASE_URL",
          "value": "jdbc:mariadb://mariadb:3306/booklore"
        },
        {
          "key": "DATABASE_USERNAME",
          "value": "booklore"
        },
        {
          "key": "DATABASE_PASSWORD",
          "value": "${DB_PASSWORD}"
        },
        {
          "key": "BOOKLORE_PORT",
          "value": "${BOOKLORE_PORT}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/app/data",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${ROOT_FOLDER_HOST}/media/data/books",
          "containerPath": "/books",
          "readOnly": false,
          "shared": false,
          "private": false
        },
        {
          "hostPath": "${ROOT_FOLDER_HOST}/media/data/bookdrop",
          "containerPath": "/bookdrop",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ],
      "dependsOn": {
        "mariadb": {
          "condition": "service_healthy"
        }
      }
    },
    {
      "name": "mariadb",
      "image": "lscr.io/linuxserver/mariadb:11.4.5",
      "internalPort": 3306,
      "environment": [
        {
          "key": "PUID",
          "value": "1000"
        },
        {
          "key": "PGID",
          "value": "1000"
        },
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "MYSQL_ROOT_PASSWORD",
          "value": "${MYSQL_ROOT_PASSWORD}"
        },
        {
          "key": "MYSQL_DATABASE",
          "value": "booklore"
        },
        {
          "key": "MYSQL_USER",
          "value": "booklore"
        },
        {
          "key": "MYSQL_PASSWORD",
          "value": "${DB_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/db",
          "containerPath": "/config",
          "readOnly": false,
          "shared": false,
          "private": false
        }
      ],
      "healthCheck": {
        "test": "mariadb-admin ping -h localhost",
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      }
    }
  ]
}
